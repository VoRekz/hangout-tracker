          },
          {
            "name": "TOTALCOST",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "double",
            "formatString": "$#,0.00;($#,0.00);$#,0.00",
            "lineageTag": "1d7a7820-ae58-49b5-948b-e9b5d8f6adfc",
            "sourceColumn": "TOTALCOST",
            "summarizeBy": "sum"
          },
          {
            "name": "SUGGESTEDBY",
            "dataType": "string",
            "sourceColumn": "SUGGESTEDBY"
          }
        ],
        "lineageTag": "1ad6de14-d891-46ad-9d2a-6bf42433d1e2",
        "measures": [
          {
            "name": "Total Spend",
            "expression": "SUM(EVENTS[TOTALCOST])",
            "formatString": "$#,0.00;($#,0.00);$#,0.00"
          },
          {
            "name": "Total Hangouts",
            "expression": "COUNTROWS(EVENTS)"
          },
          {
            "name": "Hangouts This Year",
            "expression": [
              "VAR CurrentYr = YEAR(TODAY())",
              "RETURN",
              "CALCULATE(",
              "    COUNTROWS(EVENTS),",
              "    YEAR(EVENTS[EVENTDATE]) = CurrentYr",
              ")"
            ]
          },
          {
            "name": "Days Since Last Hangout",
            "expression": [
              "VAR LastHangout = MAX(EVENTS[EVENTDATE])",
              "RETURN",
              "IF (",
              "    ISBLANK(LastHangout),",
              "    \"No Data\",",
              "    DATEDIFF(LastHangout, TODAY(), DAY) & \" days\"",
              ")"
            ]
          },
          {
            "name": "Avg Hangout Cost",
            "expression": "AVERAGE(EVENTS[TOTALCOST])",
            "formatString": "$#,0.00;($#,0.00);$#,0.00"
          },
          {
            "name": "Top Spending Category",
            "expression": "CALCULATE(SELECTEDVALUE(EVENTS[CATEGORY]), TOPN(1, ALL(EVENTS[CATEGORY]), [Total Spend], DESC))"
          },
          {
            "name": "Total Locations",
            "expression": "DISTINCTCOUNT(EVENTS[LOCATION])"
          },
          {
            "name": "Least Suggested By",
            "expression": [
              "VAR SuggestionsTable = ",
              "    ADDCOLUMNS(",
              "        ALL(PEOPLE[NAME]),",
              "        \"SuggestionCount\", ",
              "        VAR PName = PEOPLE[NAME]",
              "        RETURN",
              "        COUNTROWS(FILTER(ALL(EVENTS), CONTAINSSTRING(EVENTS[SUGGESTEDBY], PName))) + 0",
              "    )",
              "VAR MinSuggestions = MINX(SuggestionsTable, [SuggestionCount])",
              "VAR FilteredPeople = FILTER(SuggestionsTable, [SuggestionCount] = MinSuggestions)",
              "RETURN",
              "CONCATENATEX(FilteredPeople, PEOPLE[NAME], \", \") & \" (\" & MinSuggestions & \")\""
            ]
          },
          {
            "name": "Most Suggested By",
            "expression": [
              "VAR SuggestionsTable = ",
              "    ADDCOLUMNS(",
              "        ALL(PEOPLE[NAME]),",
              "        \"SuggestionCount\", ",
              "        VAR PName = PEOPLE[NAME]",
              "        RETURN",
              "        COUNTROWS(FILTER(ALL(EVENTS), CONTAINSSTRING(EVENTS[SUGGESTEDBY], PName))) + 0",
              "    )",
              "VAR MaxSuggestions = MAXX(SuggestionsTable, [SuggestionCount])",
              "VAR FilteredPeople = FILTER(SuggestionsTable, [SuggestionCount] = MaxSuggestions)",
              "RETURN",
              "CONCATENATEX(FilteredPeople, PEOPLE[NAME], \", \") & \" (\" & MaxSuggestions & \")\""
            ]
          }
        ],
        "partitions": [
          {
            "name": "EVENTS-Partition",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Snowflake.Databases(\"kdicljj-hs69473.snowflakecomputing.com\", \"COMPUTE_WH\", [Role=\"ACCOUNTADMIN\"]),",
                "    HangoutTracker_Database = Source{[Name=\"HANGOUTTRACKER\",Kind=\"Database\"]}[Data],",
